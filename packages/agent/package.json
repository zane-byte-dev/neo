{
    "name": "@neo/agent",
    "version": "0.1.0",
    "description": "Neo file-backed user, session, and Notebook data adapters.",
    "type": "module",
    "private": true,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./*.js": {
            "types": "./dist/*.d.ts",
            "import": "./dist/*.js"
        }
    },
    "typesVersions": {
        "*": {
            "*": ["./dist/*"]
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "clean": "rm -rf dist"
    }
}

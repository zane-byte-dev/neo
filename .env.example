# 🔭 inkClaw Sentinel Environment Configuration

# [Mandatory] CORE SETTINGS
WORK_DIR=/path/to/project           # 核心知识库路径 (Vault Root)
GEMINI_API_KEY=your_gemini_api_key  # Google Gemini API Key
GEMINI_MODEL=gemini-2.0-flash-exp   # 模型名称 (推荐 gemini-2.0-flash-exp)

# [Optional] PLATFORM: TELEGRAM
TELEGRAM_BOT_TOKEN=...              # 从 @BotFather 获取
TELEGRAM_CHAT_ID=...                # 授权使用的 Chat ID (数字)

# [Optional] PLATFORM: FEISHU (飞书)
FEISHU_APP_ID=...                   # 飞书应用 App ID
FEISHU_APP_SECRET=...               # 飞书应用 App Secret
FEISHU_USER_ID=...                  # 授权使用的用户 ID (或 open_id)

# [Optional] BROWSER SERVICE
PUPPETEER_EXECUTABLE_PATH=...       # 指定浏览器可执行文件路径 (可选)

# [Internal] STORAGE & CACHE
DB_PATH=./data/neo.db               # SQLite 数据库路径 (默认 ./data/neo.db)
CHAT_SESSION_TIMEOUT_HOURS=2        # 会话超时时间 (小时)
CHAT_MAX_HISTORY_MESSAGES=25        # 每个会话最大历史消息数
CHAT_MAX_CONTEXT_TOKENS=8192        # 每个会话最大 Context Token 数

# [Optional] NOTIFICATION & LOGGING
AUDIT_LOG_DIR=./logs/audit          # 审计日志目录
DEBUG=neo:*                         # 调试日志开关

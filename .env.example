# Neo Environment Configuration

# ── 必填 ─────────────────────────────────────────────────────────────────────

# 用户列表（JSON 数组），每个用户需配置 workspaceDir 指向其数据目录绝对路径
# webhookSecret 为可选字段，未设置则 /api/webhook/:userId 拒绝所有请求
USERS=[{"id":"your_user_id","name":"your_name","workspace":"your_workspace","tenants":[],"webToken":"your_web_token","workspaceDir":"/absolute/path/to/space/your_user_id"}]

# Web 服务 Session 签名密钥（生产环境必须设置为随机长字符串）
SESSION_SECRET=change-me-to-a-long-random-string

# ── LLM 提供商（至少配置一个）───────────────────────────────────────────────

GEMINI_API_KEY=your_gemini_api_key
# DEEPSEEK_API_KEY=your_deepseek_api_key
# OPENAI_API_KEY=your_openai_api_key
# ANTHROPIC_API_KEY=your_anthropic_api_key

# ── 模型配置（可选）──────────────────────────────────────────────────────────

# GEMINI_MODEL=flash          # flash | pro | gemini-acp | deepseek | gemma | ...
# OLLAMA_BASE_URL=http://localhost:11434/v1
# GEMINI_CLI_PATH=gemini      # Gemini CLI 可执行路径（用于 ACP OAuth 模式）

# ── Web 服务（可选）──────────────────────────────────────────────────────────

# WEB_PORT=3000

# ── Telegram Bot（可选）──────────────────────────────────────────────────────

# TELEGRAM_BOT_TOKEN=your_bot_token
# TELEGRAM_CHAT_ID=your_telegram_chat_id

# ── 存储路径（可选）──────────────────────────────────────────────────────────

# DB_PATH=./data/neo.db

# ── 限流与预算（可选）────────────────────────────────────────────────────────

# DAILY_COST_LIMIT=0          # 每日 USD 预算上限，0 = 不限制

# ── 调试（可选）──────────────────────────────────────────────────────────────

# LOG_LEVEL=info              # debug | info | warn | error
# DEBUG_LLM=1

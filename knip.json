{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["pm2"],
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": ["ecosystem.config.cjs", "scripts/*.mjs"],
      "project": ["scripts/**/*.mjs"]
    },
    "packages/agent": {
      "project": ["src/**/*.ts"]
    },
    "packages/app": {
      "entry": ["src/routes/**/*.ts", "src/pi/extensions/**/*.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/web": {
      "project": ["src/**/*.{ts,tsx}"]
    },
    "extension": {
      "entry": ["background.js", "content.js"],
      "project": ["**/*.js"]
    }
  }
}

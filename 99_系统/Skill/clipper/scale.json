{
  "name": "inkbrain-clipper",
  "display_name": "Inkbrain Clipper",
  "version": "1.0.0",
  "description": "Download web content to Markdown and open in Obsidian",
  "type": "script",
  "tags": ["web", "clipper"],
  "entrypoint": "script.py",
  "args": [
    {
      "name": "url",
      "description": "Target URL to clip",
      "required": true
    },
    {
      "name": "target_dir",
      "description": "Target subdirectory (default: 00_收集)",
      "required": false
    }
  ],
  "dependencies": []
}

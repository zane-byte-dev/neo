# NeoAgent Sentinel 配置文件
# 复制此文件为 .env 并填入实际配置

# Gemini CLI 配置
GEMINI_CLI_PATH=gemini              # Gemini CLI 可执行文件路径（默认从 PATH 查找）
GEMINI_TIMEOUT=180                  # CLI 超时时间（秒），默认 180 秒
GEMINI_WORK_DIR=/path/to/neo       # vault 根目录（必填）：用于注入 GEMINI.md + 自动保存会话实录

# Telegram Bot 配置
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather  # 从 @BotFather 获取
TELEGRAM_CHAT_ID=your_chat_id                     # 你的 Telegram Chat ID

# 会话保存配置（可选覆盖，默认由 GEMINI_WORK_DIR 自动推导至 history/会话/）
# CONVERSATION_SAVE_DIR=/custom/path/to/save/dir
# CONVERSATION_SAVE_ENABLED=true

# Chat History 配置
CHAT_CACHE_DIR=./cache              # 本地 session cache 目录
CHAT_SESSION_TIMEOUT_HOURS=1        # 会话超时时间（小时）
CHAT_MAX_HISTORY_MESSAGES=20        # 最大历史消息条数
CHAT_MAX_CONTEXT_TOKENS=3000        # 传给 Gemini 的上下文 token 上限（超出自动丢弃最旧消息）

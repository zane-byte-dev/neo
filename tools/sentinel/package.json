{
    "name": "NeoAgent-sentinel",
    "version": "2.0.0",
    "description": "NeoAgent Sentinel - Intelligent note monitoring service (Node.js version)",
    "type": "module",
    "main": "dist/index.js",
    "bin": {
        "neo": "dist/neo-cli.js"
    },
    "scripts": {
        "build": "tsc",
        "clean": "rm -rf dist",
        "dev:bot": "tsx src/telegram-bot.ts",
        "dev:get-chat-id": "tsx src/get-chat-id.ts",
        "butler": "tsx src/run-butler.ts",
        "curate": "tsx src/run-curate.ts",
        "start:bot": "node dist/telegram-bot.js",
        "pm2:start": "npm run build && pm2 start ecosystem.config.js",
        "pm2:stop": "pm2 stop all",
        "pm2:restart": "pm2 restart all",
        "pm2:logs": "pm2 logs",
        "pm2:status": "pm2 status"
    },
    "keywords": [
        "telegram",
        "bot",
        "obsidian",
        "notes",
        "sentinel",
        "gemini"
    ],
    "author": "Zhengchao",
    "license": "MIT",
    "dependencies": {
        "@google/generative-ai": "^0.24.1",
        "@travisvn/edge-tts": "^1.0.2",
        "dotenv": "^16.4.5",
        "execa": "^9.0.0",
        "node-cron": "^4.2.1",
        "p-queue": "^8.0.1",
        "telegraf": "^4.15.3"
    },
    "devDependencies": {
        "@types/debug": "^4.1.12",
        "@types/node": "^20.11.0",
        "@types/node-cron": "^3.0.11",
        "@types/node-fetch": "^2.6.13",
        "tsx": "^4.7.0",
        "typescript": "^5.3.3"
    },
    "engines": {
        "node": ">=18.0.0"
    }
}
# InkBrain Sentinel 配置文件
# 复制此文件为 .env 并填入实际配置

# Gemini CLI 配置
GEMINI_CLI_PATH=gemini              # Gemini CLI 可执行文件路径（默认从 PATH 查找）
GEMINI_TIMEOUT=180                  # CLI 超时时间（秒），默认 180 秒
GEMINI_WORK_DIR=                    # CLI 工作目录（可选）

# Telegram Bot 配置
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather  # 从 @BotFather 获取
TELEGRAM_CHAT_ID=your_chat_id                     # 你的 Telegram Chat ID

# 会话保存配置（可选，保存到 Obsidian vault）
CONVERSATION_SAVE_DIR=/path/to/your/obsidian/vault/收集
CONVERSATION_SAVE_ENABLED=true

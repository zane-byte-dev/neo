# Typeless 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# 服务器配置
PORT=52345

# 音频配置
SAMPLE_RATE=44100
CHANNELS=1

# 录音限制
MAX_RECORDING_DURATION=300
MIN_RECORDING_DURATION=0.3
MIN_AUDIO_VOLUME=0.01

# Local 配置
OLLAMA_API_URL=http://localhost:11434/api/generate
LOCAL_LLM_MODEL=qwen2.5:3b
WHISPER_MODEL_SIZE=small

# 语言配置（仅中英，英文不翻译）
INPUT_LANGUAGE=auto
OUTPUT_LANGUAGE=auto

# 输出目录
OUTPUT_DIR=00_收集

# 日志配置
LOG_LEVEL=INFO
LOG_DIR=logs

# NeoAgent Sentinel 配置文件
# 复制此文件为 .env 并填入实际配置

WORK_DIR=/path/to/neo       # vault 根目录（必填）：用于注入 GEMINI.md 配置与获取上下文

# Telegram Bot 配置
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather  # 从 @BotFather 获取
TELEGRAM_CHAT_ID=your_chat_id                     # 你的 Telegram Chat ID

# Chat History 配置
CHAT_CACHE_DIR=./cache              # 本地 session cache 目录
CHAT_SESSION_TIMEOUT_HOURS=1        # 会话超时时间（小时）
CHAT_MAX_HISTORY_MESSAGES=20        # 最大历史消息条数
CHAT_MAX_CONTEXT_TOKENS=3000        # 传给 Gemini 的上下文 token 上限（超出自动丢弃最旧消息）
